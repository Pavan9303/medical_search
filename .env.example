# Option A — If you have ABDM Sandbox credentials (preferred)
CLIENT_ID=your_abdm_client_id
CLIENT_SECRET=your_abdm_client_secret

# Option B — Manually set / pushed by token_refresh.py
ABDM_ACCESS_TOKEN=eyJhbGciOiJSUzI1NiIsInR...

# Required only for token_refresh.py to auto-push to Vercel
VERCEL_TOKEN=your_vercel_personal_access_token
VERCEL_PROJECT_ID=prj_xxxxxxxxxxxxxxxx
VERCEL_TEAM_ID=team_xxxxxxxxxxxxxxxx   # optional, only for team orgs
